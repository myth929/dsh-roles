{
  "name": "dsh-roles",
  "version": "0.0.1",
  "description": "Standalone DeepSeek Harness bundle for role-layered subagent orchestration with per-role context slimming, bounded step budgets, write-scope enforcement, and delegation telemetry.",
  "license": "MIT",
  "author": "myth929",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myth929/dsh-roles.git"
  },
  "homepage": "https://github.com/myth929/dsh-roles",
  "bugs": {
    "url": "https://github.com/myth929/dsh-roles/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "roles",
    "subagent",
    "orchestration"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./benchmark": {
      "types": "./lib/benchmark.d.ts",
      "default": "./lib/benchmark.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README*.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepare": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "benchmark:report": "node scripts/benchmark-report.mjs",
    "benchmark:live": "node scripts/live-benchmark.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-instructions": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-time-context": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-jobs": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-web": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.3",
    "@deepseek-ai/dsh-base": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-web-app": "0.2.2-rc.3",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
